#include <stdio.h>

int main() {

float Raio, Area, Perimetro, Pi;

printf("Digite o Valor do Raio da Circunferência: ");
scanf("%f", &Raio);

Pi = 3.14;
Area = Pi*(Raio*Raio);
Perimetro = 2*Pi*Raio;

printf(" Area da Circunferencia: %.2f", Area);
printf("\n Perimetro da Circunferencia: %.2f", Perimetro);

}