#include <stdio.h>

int main() {

int num1, num2, quociente, resto;

printf ("Digite um número inteiro: ");
scanf("%d", &num1);

printf ("Digite mais um número inteiro: ");
scanf("%d", &num2);

quociente = num1/num2;
resto = num1 % 2; 

printf("\n Esse é o seu quociente: %d", quociente);
printf("\n Esse é o resto da equação: %d", resto);


}